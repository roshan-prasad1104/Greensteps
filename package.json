{
  "name": "campus-carbon-footprint-tracker",
  "version": "1.0.0",
  "description": "Gamified Campus Carbon Footprint Tracker",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
